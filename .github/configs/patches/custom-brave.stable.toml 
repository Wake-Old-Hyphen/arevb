# ==========================================
# 1. Brave Origin (Stable APK + Stable Patches)
# ==========================================
[brave-origin-stable]
enabled = true
app-name = "brave-browser"
pkg-name = "com.brave.browser"
rv-brand = "morphe"
build-mode = "apk"
arch = "both"
patches-source = "dh6k/morphe-patches"
cli-source = "MorpheApp/morphe-desktop"
github-dlurl = "https://github.com/brave/brave-browser/releases"
apkmirror-dlurl = "https://www.apkmirror.com/apk/brave-software/brave-browser"
uptodown-dlurl = "https://brave-software-brave.en.uptodown.com/android"
patcher-args = """\
  -O"Change app name"="Brave Origin" \
  -O"Custom icon"="assets/isoamoledbraveicon.png" \
  """

# ==========================================
# 2. BraveO² (Stable APK + Stable Patches + Cloned)
# ==========================================
[brave-o2-stable]
enabled = true
app-name = "brave-browser"
pkg-name = "com.brave.origin"
rv-brand = "morphe-o2"
build-mode = "apk"
arch = "both"
patches-source = "dh6k/morphe-patches"
cli-source = "MorpheApp/morphe-desktop"
github-dlurl = "https://github.com/brave/brave-browser/releases"
apkmirror-dlurl = "https://www.apkmirror.com/apk/brave-software/brave-browser"
uptodown-dlurl = "https://brave-software-brave.en.uptodown.com/android"
included-patches = "'Default' 'Clone app'"
patcher-args = """\
  -O"Change app name"="BraveO²" \
  -O"Clone app"="com.brave.origin" \
  -O"Custom icon"="assets/isoamoledbraveicon.png" \
  """